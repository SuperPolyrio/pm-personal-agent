PM_MODEL=Qwen3.8-27B
PM_MODEL_URL=http://127.0.0.1:18800/v1
PM_MODEL_CONTEXT=131072
PM_MODEL_API_KEY=local
POLYMONITOR_URL=http://127.0.0.1:18502
POLYMONITOR_MCP_TOKEN=
# 可选。按 Polymarket 市场 slug 配置该场比赛的公开历史赔率页，JSON 对象。
PM_NBA_ODDS_REFERENCE_EVENTS=
# 数据引擎与工具路径。空值使用相邻仓库或本机用户配置目录。
MARKET_DATA_ROOT=../market-data
MARKET_DATA_PYTHON=
# 所有数据读取共用独立只读凭据；由 market_data.research setup 生成，不使用采集器账号。
MARKET_DATA_QUERY_CONFIG=
PM_STATE_DIR=var
# 通过 DSH 原生模型设置选择推理强度，off 可关闭。
PM_QUERY_REASONING=off
PM_QUERY_TEMPERATURE=0.7
# 宿主启动时预载真实 schema，其他表由模型按需 describe_data。
PM_QUERY_SCHEMAS=research.markets,research_activity,research_trades
PM_MAX_MODEL_CALLS=24
PM_MAX_TOOL_CALLS=80
PM_MAX_OUTPUT_TOKENS=4096
# 私有 SearXNG /search 地址，实例需启用 JSON 格式。engines=yahoo 时也查询同实例 Bing，需部署带 mkt 的 Bing 适配器。
PM_SEARXNG_URL=
# Exa 公共 MCP 的免密钥搜索和正文读取通道，可关闭。
PM_EXA_ENABLED=true
# 填入 LangSearch 免费 API key 后参与每条市场查询。
LANGSEARCH_API_KEY=
# 可选。匿名 Jina Reader 正文通道的专用 SOCKS 出口，例如 socks5h://127.0.0.1:18124。
PM_JINA_READER_PROXY=
# 付费或消耗套餐额度的搜索与正文读取总开关。
PM_PAID_SEARCH_ENABLED=false
# 启用 Tavily 时，从运行环境提供 TAVILY_API_KEY。短时复用套餐剩余额度并逐次预占。
# 搜索和正文提取共用状态库的累计请求上限。
PM_TAVILY_ENABLED=false
PM_TAVILY_AUTHORIZED_CALLS=0
# 启用付费备用前，在运行环境提供 SERPER_API_KEY，并确认账户可用额度。
# AUTHORIZED_CALLS 是此状态库累计授权的请求上限，发出前占用，不随重启重置。
PM_SERPER_ENABLED=false
PM_SERPER_AUTHORIZED_CALLS=0
telegram-token=
TELEGRAM_USER_ID=
# Telegram 启动器将这些配置注入 Node 的代理环境。空值使用直接连接。
PM_HTTP_PROXY=
PM_HTTPS_PROXY=
PM_NO_PROXY=localhost,127.0.0.1,::1
# 文件路径选项留空时，使用本机工具的默认位置。
PM_X_READER_PATH=
PM_PAPER_CREDENTIALS_FILE=
OPENCLI_BROWSER_CONNECT_TIMEOUT=8
# 仅在部署机启用已有模型预热。
PM_MODEL_WARMUP_URL=
PM_MODEL_WARMUP_NAME=
PM_MODEL_WARMUP_EXECUTABLE=
PM_MODEL_WARMUP_PROFILE=

